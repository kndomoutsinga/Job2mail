# Copiez ce fichier en ".env" (à la racine du projet) et remplissez vos
# propres valeurs. Le fichier ".env" ne doit JAMAIS être poussé sur Git —
# voir .gitignore, qui l'exclut déjà.

# ---------------------------------------------------------------------------
# Envoi des mails (OBLIGATOIRE pour pouvoir envoyer une candidature)
# ---------------------------------------------------------------------------
# Gmail exige un "mot de passe d'application" (pas votre mot de passe normal) :
# activez la validation en 2 étapes puis générez-en un sur
# https://myaccount.google.com/apppasswords
SENDER_EMAIL=
SENDER_NAME=
SENDER_APP_PASSWORD=
SENDER_PHONE=
SENDER_PORTFOLIO=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ---------------------------------------------------------------------------
# Recherche de contacts (facultatif — sans ces clés, l'appli tourne quand
# même, juste sans recherche automatique de contact pour ces fournisseurs)
# ---------------------------------------------------------------------------
# https://hunter.io -> compte gratuit -> clé API
HUNTER_API_KEY=
HUNTER_MONTHLY_LIMIT=50

# https://apollo.io -> compte -> Settings -> API Keys
# (utilisé uniquement pour l'enrichissement entreprise organizations/enrich)
APOLLO_API_KEY=
APOLLO_MONTHLY_LIMIT=85

# https://getprospect.com -> compte gratuit -> clé API
GETPROSPECT_API_KEY=
GETPROSPECT_MONTHLY_LIMIT=50

# ---------------------------------------------------------------------------
# France Travail (facultatif — signaux "recrute actuellement", "page
# employeur" et "fort potentiel d'embauche"). Compte gratuit sur
# https://francetravail.io -> "Mes applications" -> créer une application ->
# l'abonner aux 3 API : "Offres d'emploi v2", "Synthèse pages employeurs v1",
# "La Bonne Boîte v2". Mêmes identifiants pour les 3 (seul le "scope" change
# en interne, voir services/france_travail.py).
# ---------------------------------------------------------------------------
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------
# Nombre de jours sans réponse avant qu'une candidature apparaisse dans
# "Relances à faire" sur le tableau de bord.
FOLLOWUP_DAYS=14

# Sécurité anti-spam Gmail : nombre max de candidatures ENVOYÉES par jour.
DAILY_SEND_LIMIT=30

# Taille max d'une pièce jointe (Mo).
MAX_ATTACHMENT_SIZE_MB=10
