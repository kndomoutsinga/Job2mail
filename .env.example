# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ce fichier ne doit JAMAIS être partagé ni commité dans un dépôt git public.

# --- Recherche d'entreprises ---
# Rien à configurer ici : l'outil utilise l'API publique et gratuite
# recherche-entreprises.api.gouv.fr, sans clé ni compte.

# --- Hunter.io (source de contacts n°1) ---
# Créez un compte gratuit sur https://hunter.io puis récupérez votre clé API
# depuis https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Apollo.io (source de contacts n°2) ---
# Créez un compte sur https://apollo.io puis récupérez votre clé API depuis
# Settings -> API Keys. ATTENTION : l'accès API n'est pas garanti sur le
# plan gratuit selon les offres du moment. Si vos appels échouent en
# 401/403 malgré une clé correcte, videz cette ligne pour désactiver Apollo
# (l'outil l'ignorera simplement et passera aux autres sources).
APOLLO_API_KEY=

# --- GetProspect (source de contacts n°3, dernier recours) ---
# Créez un compte gratuit sur https://getprospect.com puis récupérez votre
# clé API dans les paramètres du compte. Utilisé uniquement pour vérifier/
# compléter un email quand Apollo a trouvé un nom mais pas d'email.
GETPROSPECT_API_KEY=

# --- Votre adresse d'envoi (Gmail conseillé) ---
# Utilisez l'adresse que vous voulez voir apparaître comme expéditeur.
SENDER_EMAIL=votre.adresse@gmail.com
SENDER_NAME=Prénom Nom

# Mot de passe d'application Gmail (PAS votre mot de passe normal).
# À générer sur https://myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes activée sur le compte Gmail)
SENDER_APP_PASSWORD=

# --- Infos de contact reprises dans les mails ---
SENDER_PHONE=06 00 00 00 00
SENDER_PORTFOLIO=https://votre-portfolio.example.com

# --- Suivi des réponses (IMAP) ---
# Réutilise SENDER_EMAIL / SENDER_APP_PASSWORD ci-dessus (même mot de passe
# d'application Gmail, valable pour l'envoi ET la lecture). Rien à créer de
# plus ici, sauf si vous changez le fournisseur mail :
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Nombre de jours sans réponse avant qu'une candidature apparaisse dans
# "Relances à faire" sur le tableau de bord.
FOLLOWUP_DAYS=7

# --- Quotas ---
# Limite d'envois par jour (sécurité anti-spam Gmail, pas un quota imposé
# par Google). Vérifiez les quotas mensuels réels sur vos tableaux de bord
# respectifs et ajustez si besoin :
DAILY_SEND_LIMIT=30
HUNTER_MONTHLY_LIMIT=50
GETPROSPECT_MONTHLY_LIMIT=50
APOLLO_MONTHLY_LIMIT=85
